# 复制此文件为 .env.local 并填入真实值。.env.local 已被 .gitignore 忽略，绝不提交。
# 每个部署环境（本地开发 / Vercel 生产）只需填「实际使用」的那一组。

# ─────────────────────────────────────────────────────────────
# Supabase
# ─────────────────────────────────────────────────────────────
# Project URL 与 Publishable/Secret key：Dashboard → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key 绕过 RLS。仅服务端与 scripts/ 使用；绝不可加 NEXT_PUBLIC_ 前缀。
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────
# Cloudflare R2
# ─────────────────────────────────────────────────────────────
# Account ID：Dashboard 右侧栏
# AK/SK：R2 → Manage R2 API Tokens → Object Read & Write（限定单个桶）
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 预签名 URL 有效期（秒）。阅读器链接会过期，页面上有刷新按钮兜底。
R2_SIGN_TTL_SECONDS=300
# 单文件上传上限（MB），前后端共用此值做前置校验。
NEXT_PUBLIC_MAX_UPLOAD_MB=50
